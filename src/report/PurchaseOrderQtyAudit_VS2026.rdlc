                                <ns0:TextRun>
                                  <ns0:Value>="Summe " &amp; Fields!DocNo.Value &amp; ":   Bestellt: " &amp; Format(Sum(Fields!QtyOrdered.Value),"#,##0.##") &amp; "   |   Empfangen (WE): " &amp; Format(Sum(Fields!QtyReceived.Value),"#,##0.##") &amp; "   |   Fakturiert: " &amp; Format(Sum(Fields!QtyInvoiced.Value),"#,##0.##") &amp; "   |   Empf./Nicht Fakt.: " &amp; Format(Sum(Fields!QtyRecvNotInv.Value),"#,##0.##") &amp; "   |   Betrag: " &amp; Format(Sum(Fields!LineAmount.Value),"#,##0.00")</ns0:Value>
                                  <ns0:Style>
