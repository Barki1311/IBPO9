                    <ns0:TablixHeader>
                      <ns0:Size>0.65cm</ns0:Size>
                      <ns0:CellContents>
                        <ns0:Textbox Name="grpHeaderDocNo">
                          <ns0:CanGrow>true</ns0:CanGrow>
                          <ns0:Paragraphs>
                            <ns0:Paragraph>
                              <ns0:TextRuns>
                                <ns0:TextRun>
                                  <ns0:Value>="Bestellung: " &amp; Fields!DocNo.Value &amp; "     Lieferant: " &amp; Fields!VendorNo.Value &amp; " – " &amp; Fields!VendorName.Value &amp; "     Datum: " &amp; Format(CDate(Fields!OrderDate.Value),"dd.MM.yyyy") &amp; "     Status: " &amp; Fields!Status.Value</ns0:Value>
                                  <ns0:Style>
                                    <ns0:FontSize>8pt</ns0:FontSize>
                                    <ns0:FontWeight>Bold</ns0:FontWeight>
